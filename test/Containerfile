# rustkube-node-test: rustkube-node's test container, per stormcentral
# docs/test-standard.md. One image for all three suites, started as
# `/test <suite>`; run as a Job in the run's own namespace
# (test/rustkube-node-test.yaml). The same image is what the suites' workload
# pods run (`/test sized …`), so nothing else is pulled.
#
# The context is the repo root; test/build.sh (run first, on the build box)
# builds the static musl binary into test/.stage/test. Compiling inside
# `podman build` pulled rust:1-alpine and built with no cache on every run.
#
#   test/build.sh && podman build -f test/Containerfile \
#     --build-arg COMMIT=$(git rev-parse HEAD) -t rustkube-node-test .
#
# The binary needs nothing under it: it verifies the apiserver with the
# ServiceAccount's mounted ca.crt, not a trust store.
FROM scratch
ARG COMMIT=unknown
LABEL storm.io/test-of="rustkube-node" storm.io/test-commit="${COMMIT}"
COPY test/.stage/test /test
ENTRYPOINT ["/test"]
